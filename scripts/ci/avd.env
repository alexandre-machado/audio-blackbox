# AVD definition for the instrumented ("emulator") test tier -- issue #34.
#
# Single source of truth shared by .github/workflows/ci.yml (the CI emulator job) and
# scripts/run-instrumented-tests.sh (the local single-command runner), so the two never drift.
#
# API_LEVEL=30 (Android 11 "R"), chosen deliberately, not defaulted to minSdk (29) or targetSdk
# (36):
#   - AudioRecordingConfiguration.isClientSilenced -- the exact mechanism RecorderService uses to
#     detect a real phone-call interruption (see RecorderService.recordingCallback) -- requires
#     API 30+. Below that, the interruption path this tier exists to exercise does not exist at
#     all (a documented, accepted gap on API 29 -- see RecorderService's class doc).
#   - 30 is therefore the floor at which the feature under test is even present: passing here is
#     the strictest fence available for every device this app supports from that floor up, and a
#     30 image boots and runs measurably faster in CI than a 34/36 image, which buys back wall
#     clock without weakening the guarantee (the JVM suite already covers config/logic uniformly
#     across API levels; this tier's job is the platform wiring, not another API-level matrix).
#
# TARGET=google_apis (not google_apis_playstore or the bare AOSP "default" target): google_apis
# system images ship the telephony/radio stack `adb emu gsm call`/`gsm cancel` needs to raise a
# simulated incoming call -- the AOSP "default" target's telephony support is inconsistent across
# API levels, and google_apis_playstore images are read-only (can't be provisioned the way CI
# needs) and unnecessarily heavier.
#
# ARCH=x86_64: GitHub Actions' ubuntu-latest runners are x86_64 with /dev/kvm available, so an
# x86_64 image gets hardware-accelerated (KVM) boot; an arm64 image would run under much slower
# software emulation on this host architecture.
API_LEVEL=30
TARGET=google_apis
ARCH=x86_64
PROFILE=pixel
AVD_NAME=audio_blackbox_ci
