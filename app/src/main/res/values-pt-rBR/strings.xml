    <!-- Launcher label only. Overridden per build type so a staging install is
         distinguishable on the home screen; app_name above stays the product name so the
         in-app header (DashboardScreen) never renders a build tag into a screenshot. -->
    <string name="app_launcher_name">Audio Blackbox</string>

    <!-- Tela única de consentimento (issue #213) -->
    <string name="onboarding_consent_title">Antes de começar</string>
    <string name="onboarding_consent_body">O Audio Blackbox grava áudio ambiente continuamente em segundo plano, mantendo apenas os minutos mais recentes em um buffer contínuo na memória. O áudio fica somente na memória deste aparelho e nunca é enviado a lugar nenhum. Ele só é salvo em um arquivo quando você toca em Salvar. Gravar conversas pode exigir o consentimento de todas as pessoas envolvidas, dependendo da legislação da sua jurisdição, e você é responsável por usar este aplicativo de acordo com a lei aplicável.</string>
    <string name="onboarding_consent_accept">Aceitar e continuar</string>
    <string name="onboarding_consent_decline">Recusar e sair</string>
    <string name="onboarding_consent_privacy_link">Política de privacidade</string>

    <!-- RECORD_AUDIO rationale (apenas recuperação, após uma negativa) -->
    <string name="onboarding_audio_title">Permissão de microfone</string>
    <string name="onboarding_audio_body">O Audio Blackbox precisa de acesso ao microfone para gravar o áudio dos últimos minutos em um buffer contínuo. Sem essa permissão, o aplicativo não pode gravar nada.</string>
    <string name="onboarding_audio_grant">Permitir microfone</string>

    <!-- RECORD_AUDIO permanently denied -->
    <string name="onboarding_audio_denied_title">Microfone bloqueado</string>
    <string name="onboarding_audio_denied_body">Você negou permanentemente o acesso ao microfone. O Audio Blackbox não pode gravar sem ele. Abra as configurações do aplicativo e permita o acesso ao microfone manualmente.</string>
    <string name="onboarding_open_settings">Abrir configurações do aplicativo</string>

    <!-- POST_NOTIFICATIONS rationale (apenas recuperação, mesmo motivo acima) -->
    <string name="onboarding_notifications_title">Permissão de notificações</string>
    <string name="onboarding_notifications_body">O Audio Blackbox grava em segundo plano usando um serviço em primeiro plano, que exige uma notificação permanente mostrando que a gravação está ativa. Sem essa permissão, o Android pode impedir o serviço de continuar.</string>
    <string name="onboarding_notifications_grant">Permitir notificações</string>

    <!-- POST_NOTIFICATIONS permanently denied -->
    <string name="onboarding_notifications_denied_title">Notificações bloqueadas</string>
    <string name="onboarding_notifications_denied_body">Você negou permanentemente a permissão de notificações. Abra as configurações do aplicativo para permiti-la manualmente e garantir que a gravação em segundo plano continue funcionando.</string>

