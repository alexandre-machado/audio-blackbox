<resources xmlns:tools="http://schemas.android.com/tools">
    <string name="app_name">Audio Blackbox</string>
    <!-- Launcher label only. Overridden per build type so a staging install is
         distinguishable on the home screen; see values/strings.xml. -->
    <string name="app_launcher_name">Audio Blackbox</string>

    <!-- French (issue #420). Glossary: buffer = mémoire tampon / tampon; save the past =
         sauvegarder le passé; forward/live recording = enregistrement en direct; retention
         window = fenêtre de conservation; Settings = Paramètres. "Save" is "Sauvegarder", never
         "Enregistrer", which is reserved for "record" to keep the two actions distinct.
         Typography: a no-break space (\u00A0) before ":", "?", "%" per French convention. -->

    <!-- Écran de consentement (issue #213): faithful translation of the default consent text. -->
    <string name="onboarding_consent_title">Avant de commencer</string>
    <string name="onboarding_consent_body">Audio Blackbox enregistre en continu le son ambiant en arrière-plan et ne conserve que les dernières minutes dans une mémoire tampon circulaire en mémoire vive. L\'audio reste uniquement dans la mémoire de cet appareil et n\'est jamais envoyé nulle part. Il n\'est sauvegardé dans un fichier que lorsque vous appuyez sur Sauvegarder. Enregistrer des conversations peut nécessiter le consentement de toutes les personnes concernées, selon les lois de votre juridiction, et vous êtes responsable de l\'utilisation de cette application conformément à la loi applicable.</string>
    <string name="onboarding_consent_accept">Accepter et continuer</string>
    <string name="onboarding_consent_decline">Refuser et quitter</string>
    <string name="onboarding_consent_privacy_link">Politique de confidentialité</string>

    <!-- RECORD_AUDIO rationale -->
    <string name="onboarding_audio_title">Autorisation du micro</string>
    <string name="onboarding_audio_body">Audio Blackbox a besoin d\'accéder au micro pour enregistrer les dernières minutes d\'audio dans une mémoire tampon continue. Sans cette autorisation, l\'application ne peut rien enregistrer.</string>
    <string name="onboarding_audio_grant">Autoriser le micro</string>

    <!-- RECORD_AUDIO permanently denied -->
    <string name="onboarding_audio_denied_title">Micro bloqué</string>
    <string name="onboarding_audio_denied_body">Vous avez refusé définitivement l\'accès au micro. Audio Blackbox ne peut pas enregistrer sans lui. Ouvrez les paramètres de l\'application et autorisez l\'accès au micro manuellement.</string>
    <string name="onboarding_open_settings">Ouvrir les paramètres de l\'appli</string>

    <!-- POST_NOTIFICATIONS rationale -->
    <string name="onboarding_notifications_title">Autorisation des notifications</string>
    <string name="onboarding_notifications_body">Audio Blackbox enregistre en arrière-plan à l\'aide d\'un service de premier plan, qui exige une notification permanente indiquant que l\'enregistrement est actif. Sans cette autorisation, Android peut arrêter le service.</string>
    <string name="onboarding_notifications_grant">Autoriser les notifications</string>

    <!-- POST_NOTIFICATIONS permanently denied -->
    <string name="onboarding_notifications_denied_title">Notifications bloquées</string>
    <string name="onboarding_notifications_denied_body">Vous avez refusé définitivement l\'autorisation des notifications. Ouvrez les paramètres de l\'application pour l\'accorder manuellement et garantir que l\'enregistrement en arrière-plan continue de fonctionner.</string>

