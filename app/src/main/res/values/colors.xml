<resources>
    <!--
      App icon background. The foreground is a cleanly isolated, transparent
      raster PNG of the Flight Recorder hardware. A dark surface tone (#141418)
      provides contrast and matches modern Material 3 dark themes.
    -->
    <color name="ic_launcher_background">#141418</color>

    <!--
      Cockpit ground (issue #225, model.html:37-41, color-cockpit-bg custom property). Used only
      as the pre-Compose android:windowBackground in themes.xml, so the window is already the
      fixed dark cockpit color for the single frame before AudioBlackboxTheme's Compose
      ColorScheme (ui/theme/Theme.kt) takes over; keep the two in sync if the cockpit ground
      ever changes.
    -->
    <color name="cockpit_bg">#0A0E17</color>

    <!--
      Widget colors (issue #275). RemoteViews layouts cannot reference the Compose ui/theme/Color.kt
      tokens directly, so these are hand-mirrored from that file / model.html (AGENTS.md §5); keep
      the two in sync if either changes.
      widget_panel_background/border: CockpitPanel/CockpitBorderStrong, a fully opaque panel (see
      widget_background.xml's doc on why this, not translucency, is how wallpaper contrast is
      handled). widget_annunciator_*: AvionicsGreen/CautionAmber/WarningRed/TextDim, the documented
      annunciator rule (recording/paused/error/idle-dim). widget_action_button: FlightOrange, the
      brand primary-CTA color, per AGENTS.md §5's rule that state colors are never used for a plain
      CTA button. widget_action_button_pressed: FlightOrangeDark, the button's own pressed-state
      darken (Color.kt's FlightOrangeDark, #FFBF360C), still never a state color. widget_text_stencil:
      TextStencil, the same text-on-panel pairing already proven legible across the in-app cockpit
      screens.
    -->
    <color name="widget_panel_background">#FF111827</color>
    <color name="widget_panel_border">#29FFFFFF</color>
    <color name="widget_annunciator_recording">#FF10B981</color>
    <color name="widget_annunciator_paused">#FFF59E0B</color>
    <color name="widget_annunciator_error">#FFEF4444</color>
    <color name="widget_annunciator_idle">#FF64748B</color>
    <color name="widget_action_button">#FFFF5722</color>
    <color name="widget_action_button_pressed">#FFBF360C</color>
    <color name="widget_text_stencil">#FFF8FAFC</color>
    <color name="widget_text_on_action">#FFFFFFFF</color>
</resources>
