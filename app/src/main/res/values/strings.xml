         selector from #45/#57) -->
    <string name="settings_title">Settings</string>
    <string name="settings_subtitle">Audio buffer &amp; application preferences</string>
    <string name="settings_specs_title">Audio engine specifications</string>
    <string name="settings_specs_format_label">Audio format</string>
