    <string name="settings_specs_persistence_value">MediaStore (Local storage)</string>
    <string name="settings_privacy_title">Privacy &amp; local processing</string>
    <string name="settings_privacy_explanation">Audio Blackbox operates purely locally on your device. Microphone audio is kept in transient RAM and overwritten automatically. Zero telemetry, crash reports, or audio streams are ever sent to remote servers.</string>
    <string name="settings_retention_title">Rolling buffer retention window</string>
    <string name="settings_retention_explanation">How much audio the buffer keeps in device memory. A larger value uses more memory. Use the buttons below to choose a value, then tap Apply.</string>
    <string name="settings_retention_value">%1$d min (~%2$d MB)</string>
    <!-- Not a plural: AudioConfig.RETENTION_WINDOW_MIN_MINUTES/MAX_MINUTES/STEP_MINUTES bound the
         stepper to multiples of 5 in [5, 45] (issue #72's interim clamp, was [5, 60]), so the value
         is never 1, and the "minutes" (plural) form is always correct here. This was true under the
         old fixed-list domain too (re-examined for issue #44), and the stepper's range+step domain
         does not change that: every reachable value, including newly-reachable ones like 35/40, is
         still a multiple of 5. Re-examined again for issue #73, and again for issue #72's clamp. -->
    <string name="settings_retention_value_active_cd" tools:ignore="PluralsCandidate">%1$d minutes, approximately %2$d megabytes, currently active</string>
    <string name="settings_retention_value_pending_cd" tools:ignore="PluralsCandidate">%1$d minutes, approximately %2$d megabytes, not yet applied</string>
    <string name="settings_retention_decrement_cd">Decrease retention by 5 minutes</string>
    <string name="settings_retention_increment_cd">Increase retention by 5 minutes</string>
    <string name="settings_retention_pending_notice">%1$d min is still active until you apply this change</string>
    <string name="settings_retention_apply_button">Apply</string>
    <string name="settings_retention_confirm_title">Switch retention now?</string>
    <string name="settings_retention_confirm_body">Switching to %1$d min requires stopping the recording, which discards all audio currently in memory. That recording can\'t be recovered afterward.</string>
    <string name="settings_retention_confirm_accept">Stop and switch</string>
    <string name="settings_retention_confirm_cancel">Cancel</string>

    <!-- Clamp-down notice (issue #84): shown at most once, only to a user whose stored retention
         window (50/55/60, persisted before issue #72's interim clamp) was reduced on load. Never
         shown to a user already at or below the current max. -->
    <string name="settings_retention_clamp_notice_title">Retention window reduced</string>
    <!-- Not a plural, same reasoning as settings_retention_value_active_cd above: %1$d is always a
         pre-clamp value (50/55/60) and %2$d is always AudioConfig.RETENTION_WINDOW_MAX_MINUTES
         (45), so neither is ever 1. -->
    <string name="settings_retention_clamp_notice_body" tools:ignore="PluralsCandidate">Your retention window was reduced from %1$d to %2$d minutes as an interim memory-safety measure while a permanent fix is in progress.</string>
    <string name="settings_retention_clamp_notice_dismiss">Got it</string>
