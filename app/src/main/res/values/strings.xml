<resources xmlns:tools="http://schemas.android.com/tools">
    <string name="app_name">Audio Blackbox</string>

    <!-- Legal / consent notice -->
    <string name="onboarding_legal_title">Legal notice</string>
    <string name="onboarding_legal_body">Audio Blackbox continuously records audio in the background. Recording conversations may require the consent of everyone involved, depending on the laws of your jurisdiction. You are responsible for using this app in accordance with applicable law.</string>
    <string name="onboarding_legal_continue">I understand, continue</string>

    <!-- RECORD_AUDIO rationale -->
    <string name="onboarding_audio_title">Microphone permission</string>
    <string name="onboarding_audio_body">Audio Blackbox needs microphone access to record the last few minutes of audio in a continuous buffer. Without this permission, the app can\'t record anything.</string>
    <string name="onboarding_audio_grant">Allow microphone</string>

    <!-- RECORD_AUDIO permanently denied -->
    <string name="onboarding_audio_denied_title">Microphone blocked</string>
    <string name="onboarding_audio_denied_body">You\'ve permanently denied microphone access. Audio Blackbox can\'t record without it. Open the app settings and allow microphone access manually.</string>
    <string name="onboarding_open_settings">Open app settings</string>

    <!-- POST_NOTIFICATIONS rationale -->
    <string name="onboarding_notifications_title">Notification permission</string>
    <string name="onboarding_notifications_body">Audio Blackbox records in the background using a foreground service, which requires a persistent notification showing that recording is active. Without this permission, Android may stop the service.</string>
    <string name="onboarding_notifications_grant">Allow notifications</string>

    <!-- POST_NOTIFICATIONS permanently denied -->
    <string name="onboarding_notifications_denied_title">Notifications blocked</string>
    <string name="onboarding_notifications_denied_body">You\'ve permanently denied the notifications permission. Open the app settings to allow it manually and make sure background recording keeps working.</string>

    <!-- Battery optimization -->
    <string name="onboarding_battery_title">Battery optimization</string>
    <string name="onboarding_battery_body">Some manufacturers (Samsung, Xiaomi, among others) aggressively kill background apps to save battery. To keep continuous recording from being interrupted, it\'s recommended that you exempt Audio Blackbox from battery optimization.</string>
    <string name="onboarding_battery_grant">Exempt from battery optimization</string>
    <string name="onboarding_battery_skip">Skip for now</string>
    <string name="onboarding_battery_warning">Without this exemption, the system may interrupt background recording. You can turn it on later in the app settings.</string>

