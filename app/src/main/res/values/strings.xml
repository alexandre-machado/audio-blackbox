    <!-- Retention window selector (issue #45) -->
    <string name="dashboard_retention_title">Memory retention</string>
    <string name="dashboard_retention_explanation">How much audio the buffer keeps in device memory. A larger value uses more memory.</string>
    <string name="dashboard_retention_option">%1$d min (~%2$d MB)</string>
    <!-- Not a plural: AudioConfig.RETENTION_WINDOW_OPTIONS_MINUTES is 5/15/30/60, never 1, so the
         "minutes" (plural) form is always correct here too. English pluralization rules differ
         from Portuguese's, but that distinction only matters when the singular case (1) can
         occur, and it never does for this constant, see its bounds comment. Re-examined for
         issue #44; still not a plurals candidate in either locale. -->
    <string name="dashboard_retention_option_cd" tools:ignore="PluralsCandidate">Keep %1$d minutes in memory, approximately %2$d megabytes</string>
    <string name="dashboard_retention_confirm_title">Switch retention now?</string>
    <string name="dashboard_retention_confirm_body">Switching to %1$d min requires stopping the recording, which discards all audio currently in memory. That recording can\'t be recovered afterward.</string>
    <string name="dashboard_retention_confirm_accept">Stop and switch</string>
    <string name="dashboard_retention_confirm_cancel">Cancel</string>
