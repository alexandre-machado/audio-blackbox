    <string name="settings_privacy_explanation">Audio Blackbox operates purely locally on your device. Microphone audio is kept in transient RAM and overwritten automatically. Zero telemetry, crash reports, or audio streams are ever sent to remote servers.</string>
    <string name="settings_retention_title">Rolling buffer retention window</string>
    <string name="settings_retention_explanation">How much audio the buffer keeps in device memory. A larger value uses more memory. Changes apply automatically a moment after you stop adjusting.</string>
    <string name="settings_retention_value">%1$d min (~%2$d MB)</string>
    <!-- Not a plural: AudioConfig.RETENTION_WINDOW_MIN_MINUTES/STEP_MINUTES bound the stepper to
         multiples of 5, at least 5 (issue #298 removed the fixed upper MAX_MINUTES in favor of a
         per-device DeviceMemoryBudget ceiling, always itself a multiple of 5), so the value is
         never 1, and the "minutes" (plural) form is always correct here. This was true under the
         old fixed-list domain too (re-examined for issue #44), and every domain change since (issue
         #73's range+step, issue #72's interim clamp, issue #298's dynamic ceiling) has kept every
         reachable value a multiple of 5. -->
    <string name="settings_retention_value_active_cd" tools:ignore="PluralsCandidate">%1$d minutes, approximately %2$d megabytes, currently active</string>
    <!-- Issue #299: "not yet applied" still holds. There is a brief debounce window between a tap
         and the auto-commit, not an Apply step waiting on the user. -->
    <string name="settings_retention_value_pending_cd" tools:ignore="PluralsCandidate">%1$d minutes, approximately %2$d megabytes, not yet applied</string>
    <string name="settings_retention_decrement_cd">Decrease retention by 5 minutes</string>
