    <!-- Spanish (issue #420), neutral European register with "tú". Glossary: buffer = búfer;
         save the past = guardar el pasado; forward/live recording = grabación en directo;
         retention window = ventana de retención; Settings = Ajustes. -->

    <!-- Pantalla de consentimiento (issue #213): faithful translation of the default consent text. -->
    <string name="onboarding_consent_title">Antes de empezar</string>
    <string name="onboarding_consent_body">Audio Blackbox graba continuamente el audio ambiente en segundo plano y conserva solo los minutos más recientes en un búfer circular en memoria. El audio permanece únicamente en la memoria de este dispositivo y nunca se envía a ningún sitio. Solo se guarda en un archivo cuando tocas Guardar. Grabar conversaciones puede requerir el consentimiento de todas las personas implicadas, según las leyes de tu jurisdicción, y eres responsable de usar esta aplicación de acuerdo con la legislación aplicable.</string>
    <string name="onboarding_consent_accept">Aceptar y continuar</string>
    <string name="onboarding_consent_decline">Rechazar y salir</string>
    <string name="onboarding_consent_privacy_link">Política de privacidad</string>

    <!-- RECORD_AUDIO rationale -->
    <string name="onboarding_audio_title">Permiso de micrófono</string>
    <string name="onboarding_audio_body">Audio Blackbox necesita acceso al micrófono para grabar los últimos minutos de audio en un búfer continuo. Sin este permiso, la aplicación no puede grabar nada.</string>
    <string name="onboarding_audio_grant">Permitir micrófono</string>

    <!-- RECORD_AUDIO permanently denied -->
    <string name="onboarding_audio_denied_title">Micrófono bloqueado</string>
    <string name="onboarding_audio_denied_body">Has denegado el acceso al micrófono de forma permanente. Audio Blackbox no puede grabar sin él. Abre los ajustes de la aplicación y permite el acceso al micrófono manualmente.</string>
    <string name="onboarding_open_settings">Abrir ajustes de la aplicación</string>

    <!-- POST_NOTIFICATIONS rationale -->
    <string name="onboarding_notifications_title">Permiso de notificaciones</string>
    <string name="onboarding_notifications_body">Audio Blackbox graba en segundo plano mediante un servicio en primer plano, que requiere una notificación permanente que indica que la grabación está activa. Sin este permiso, Android puede detener el servicio.</string>
    <string name="onboarding_notifications_grant">Permitir notificaciones</string>

    <!-- POST_NOTIFICATIONS permanently denied -->
    <string name="onboarding_notifications_denied_title">Notificaciones bloqueadas</string>
    <string name="onboarding_notifications_denied_body">Has denegado el permiso de notificaciones de forma permanente. Abre los ajustes de la aplicación para permitirlo manualmente y asegurarte de que la grabación en segundo plano siga funcionando.</string>

