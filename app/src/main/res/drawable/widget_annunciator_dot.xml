<?xml version="1.0" encoding="utf-8"?>
<!--
  Plain white oval, always re-tinted at render time via RemoteViews.setInt(..., "setColorFilter",
  ...) in RecordingWidgetRenderer; the actual color (green/amber/red/dim) is decided by
  RecordingWidgetStateMapper from real capture state, never hardcoded here.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="#FFFFFFFF" />
</shape>
