         Settings = Einstellungen. Keep new strings consistent with these terms. -->

    <!-- Einwilligungsbildschirm (issue #213): faithful translation of the default consent text. -->
    <string name="onboarding_consent_title">Bevor du startest</string>
    <string name="onboarding_consent_body">Audio Blackbox nimmt im Hintergrund fortlaufend Umgebungsgeräusche auf und behält dabei nur die letzten Minuten in einem rollierenden Puffer im Arbeitsspeicher. Das Audio bleibt ausschließlich im Speicher dieses Geräts und wird nirgendwohin gesendet. Es wird nur dann in einer Datei gespeichert, wenn du auf Speichern tippst. Das Aufnehmen von Gesprächen kann je nach den Gesetzen deiner Rechtsordnung die Einwilligung aller Beteiligten erfordern, und du bist dafür verantwortlich, diese App im Einklang mit dem geltenden Recht zu verwenden.</string>
    <string name="onboarding_consent_accept">Akzeptieren und weiter</string>
    <string name="onboarding_consent_decline">Ablehnen und beenden</string>
    <string name="onboarding_consent_privacy_link">Datenschutzerklärung</string>

    <!-- RECORD_AUDIO rationale -->
    <string name="onboarding_audio_title">Mikrofonberechtigung</string>
    <string name="onboarding_audio_body">Audio Blackbox braucht Zugriff auf das Mikrofon, um die letzten Minuten Audio in einem fortlaufenden Puffer aufzunehmen. Ohne diese Berechtigung kann die App nichts aufnehmen.</string>
    <string name="onboarding_audio_grant">Mikrofon erlauben</string>

    <!-- RECORD_AUDIO permanently denied -->
    <string name="onboarding_audio_denied_title">Mikrofon blockiert</string>
    <string name="onboarding_audio_denied_body">Du hast den Mikrofonzugriff dauerhaft verweigert. Ohne ihn kann Audio Blackbox nicht aufnehmen. Öffne die App-Einstellungen und erlaube den Mikrofonzugriff manuell.</string>
    <string name="onboarding_open_settings">App-Einstellungen öffnen</string>

    <!-- POST_NOTIFICATIONS rationale -->
    <string name="onboarding_notifications_title">Benachrichtigungsberechtigung</string>
    <string name="onboarding_notifications_body">Audio Blackbox nimmt über einen Vordergrunddienst im Hintergrund auf. Dafür ist eine dauerhafte Benachrichtigung nötig, die anzeigt, dass die Aufnahme aktiv ist. Ohne diese Berechtigung kann Android den Dienst beenden.</string>
    <string name="onboarding_notifications_grant">Benachrichtigungen erlauben</string>

    <!-- POST_NOTIFICATIONS permanently denied -->
    <string name="onboarding_notifications_denied_title">Benachrichtigungen blockiert</string>
    <string name="onboarding_notifications_denied_body">Du hast die Benachrichtigungsberechtigung dauerhaft verweigert. Öffne die App-Einstellungen, um sie manuell zu erlauben, damit die Hintergrundaufnahme weiter funktioniert.</string>

