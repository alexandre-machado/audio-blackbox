    <!-- Italian (issue #420), informal "tu" as is usual for Android apps. Glossary: buffer =
         buffer; save the past = salva il passato; forward/live recording = registrazione live;
         retention window = finestra di conservazione; Settings = Impostazioni. -->

    <!-- Schermata di consenso (issue #213): faithful translation of the default consent text. -->
    <string name="onboarding_consent_title">Prima di iniziare</string>
    <string name="onboarding_consent_body">Audio Blackbox registra continuamente l\'audio ambientale in background, conservando solo i minuti più recenti in un buffer circolare in memoria. L\'audio resta solo nella memoria di questo dispositivo e non viene mai inviato da nessuna parte. Viene salvato in un file solo quando tocchi Salva. La registrazione di conversazioni può richiedere il consenso di tutte le persone coinvolte, a seconda delle leggi della tua giurisdizione, e sei responsabile dell\'uso di questa app in conformità con la legge applicabile.</string>
    <string name="onboarding_consent_accept">Accetta e continua</string>
    <string name="onboarding_consent_decline">Rifiuta ed esci</string>
    <string name="onboarding_consent_privacy_link">Informativa sulla privacy</string>

    <!-- RECORD_AUDIO rationale -->
    <string name="onboarding_audio_title">Autorizzazione microfono</string>
    <string name="onboarding_audio_body">Audio Blackbox ha bisogno di accedere al microfono per registrare gli ultimi minuti di audio in un buffer continuo. Senza questa autorizzazione, l\'app non può registrare nulla.</string>
    <string name="onboarding_audio_grant">Consenti microfono</string>

    <!-- RECORD_AUDIO permanently denied -->
    <string name="onboarding_audio_denied_title">Microfono bloccato</string>
    <string name="onboarding_audio_denied_body">Hai negato in modo permanente l\'accesso al microfono. Audio Blackbox non può registrare senza. Apri le impostazioni dell\'app e consenti l\'accesso al microfono manualmente.</string>
    <string name="onboarding_open_settings">Apri impostazioni dell\'app</string>

    <!-- POST_NOTIFICATIONS rationale -->
    <string name="onboarding_notifications_title">Autorizzazione notifiche</string>
    <string name="onboarding_notifications_body">Audio Blackbox registra in background tramite un servizio in primo piano, che richiede una notifica permanente che indica che la registrazione è attiva. Senza questa autorizzazione, Android potrebbe interrompere il servizio.</string>
    <string name="onboarding_notifications_grant">Consenti notifiche</string>

    <!-- POST_NOTIFICATIONS permanently denied -->
    <string name="onboarding_notifications_denied_title">Notifiche bloccate</string>
    <string name="onboarding_notifications_denied_body">Hai negato in modo permanente l\'autorizzazione alle notifiche. Apri le impostazioni dell\'app per consentirla manualmente e far sì che la registrazione in background continui a funzionare.</string>

    <!-- Ottimizzazione batteria (banner after onboarding) -->
    <string name="onboarding_battery_grant">Escludi dall\'ottimizzazione della batteria</string>
    <string name="onboarding_battery_warning">Senza questa esclusione, il sistema potrebbe interrompere la registrazione in background. Puoi attivarla più tardi nelle impostazioni dell\'app.</string>

