<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      Explicit opt-out of Google Play Advertising ID (AD_ID) for Google Play policy compliance.
      Ensures no transitive dependency ever injects AD_ID into the merged manifest.
    -->
    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />

    <!--
      Privacy invariant: Audio Blackbox is 100% offline, contains zero network egress, zero tracking, and zero advertisements.
    -->

    <!--
      android:allowBackup="false" and android:dataExtractionRules are both
      present on purpose: allowBackup="false" blocks cloud Auto Backup and
      `adb backup`, but on some OEMs it does not block device-to-device
      transfer (Samsung Smart Switch, Google Quick Start) on API 31+. The
      dataExtractionRules file adds an explicit device-transfer exclusion
      for that path. Do not remove either one; see
      app/src/main/res/xml/data_extraction_rules.xml for the full domain
      coverage, the documented residual gaps (API 29-30, see minSdk in
      app/build.gradle.kts; and exported/shared-storage recordings), and
      what remains unconfirmed vs. documentation-confirmed.
    -->
    <application
        android:name=".AudioBlackboxApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_launcher_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AudioBlackbox">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.AudioBlackbox">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          foregroundServiceType="microphone" is mandatory on API 29+ for a service that records
          audio in the background (see minSdk in app/build.gradle.kts, chosen specifically so this
          type is always available). android:exported="false": only this app ever starts it, via
          explicit Intents built by RecorderService.startIntent()/stopIntent()/saveIntent(), never
          through an external Intent (see issue #3: a foreground service must be started from a
          visible, user-initiated context, not from the background).
        -->
        <service
            android:name=".service.RecorderService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <receiver
            android:name=".service.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!--
          Home-screen widget (issue #275), replacing the Quick Settings tile removed in #273/#274.
          App-widget interaction is on Android 14+'s while-in-use permission eligibility list
          for a microphone-typed foreground service, TileService is not (AGENTS.md §11), and a
          spike proved a genuine widget tap starts the mic FGS cleanly on the owner's hardware
          (issue #267). android:exported="true" is required for the launcher's AppWidgetHost to
          bind and deliver clicks; the spike learned that copying the tile's exported="false"
          pattern breaks widget binding. The only externally reachable action is the platform's own
          APPWIDGET_UPDATE broadcast; RecordingWidgetProvider answers it with nothing but a
          re-render of already-real capture state and accepts no externally-controlled data, so
          this export carries no start/stop control surface (contrast with the spike's throwaway,
          deliberately-not-shipped TEST_START/TEST_STOP broadcast hooks).
        -->
        <receiver
            android:name=".widget.RecordingWidgetProvider"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/recording_widget_info" />
        </receiver>
    </application>

</manifest>
