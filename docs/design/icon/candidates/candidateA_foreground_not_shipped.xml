<!--
  Adaptive icon foreground layer (issue #49) — Candidate A, "banded capsule".

  A single rounded-capsule silhouette (the CSMU housing) in a neutral light
  fill, centered in the 66dp guaranteed-safe zone, with one inset orange band
  as the sole saturated accent. The band is cut out of the capsule itself
  (evenOdd hole) with a thin transparent groove on each side, so the band
  reads as a distinct raised shape even when this layer is flattened to a
  single tint for the monochrome/themed-icon state — it does not depend on
  the hue surviving.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="@color/ic_launcher_capsule"
        android:fillType="evenOdd"
        android:pathData="M40,38 L68,38 A16,16 0 0 1 84,54 L84,54 A16,16 0 0 1 68,70 L40,70 A16,16 0 0 1 24,54 L24,54 A16,16 0 0 1 40,38 Z M45,38 L63,38 L63,70 L45,70 Z" />
    <path
        android:fillColor="@color/ic_launcher_accent"
        android:pathData="M46.5,38 L61.5,38 L61.5,70 L46.5,70 Z" />
</vector>
